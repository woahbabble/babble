{
  "manifest_version": 3,
  "name": "Babble",
  "version": "0.1.0",
  "description": "Comment on anything, anywhere on the internet.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://babble.local:3001/*"
  ],
  "action": {
    "default_title": "Open Babble",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "babble@woahbabble.com",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "sidebar.js", "env.js"],
      "matches": ["<all_urls>"]
    }
  ]
}