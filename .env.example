# Copy to .env and adjust values.
# For Docker Compose, DATABASE_URL points to the db service.
# For production, set strong JWT_SECRET, ADMIN_TOKEN, and appropriate CORS_ORIGINS.

# Server
PORT=3001
API_HOST=localhost
USE_HTTPS=0
NODE_ENV=development

# Database — for Docker Compose
DATABASE_URL=postgres://babble:babble@localhost:5432/babble
PGSSLMODE=disable

JWT_SECRET=dev-secret-change-in-production
CORS_ORIGINS=*
ADMIN_TOKEN=admin

# Rate limiting
RL_SIGNUP_WINDOW_MS=900000
RL_SIGNUP_MAX=10
RL_LOGIN_WINDOW_MS=900000
RL_LOGIN_MAX=30
RL_COMMENTS_WINDOW_MS=60000
RL_COMMENTS_MAX=5
RL_SEARCH_WINDOW_MS=60000
RL_SEARCH_MAX=60
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120

# Website
BABBLE_API_BASE=http://localhost:3001/api
