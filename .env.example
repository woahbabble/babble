# Server
PORT=3001
API_HOST=babble.local
SSL_KEY_PATH=./babble.local-key.pem
SSL_CERT_PATH=./babble.local.pem
USE_HTTPS=1
DATABASE_URL=
JWT_SECRET=change-this-to-a-very-long-random-secret

# Comma-separated origins, or * for all
CORS_ORIGINS=*
ADMIN_TOKEN=change-me
API_URL=https://babble.local:3001/api

# Rate limiting
RL_SIGNUP_WINDOW_MS=900000
RL_SIGNUP_MAX=10
RL_LOGIN_WINDOW_MS=900000
RL_LOGIN_MAX=30
RL_COMMENTS_WINDOW_MS=60000
RL_COMMENTS_MAX=5
RL_SEARCH_WINDOW_MS=60000
RL_SEARCH_MAX=60
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120

# Website (if running from repo root tooling)
BABBLE_API_BASE=https://babble.local:3001/api
BABBLE_ALLOW_INSECURE_LOCAL_TLS=1

# Extension runtime defaults (manual: set in chrome.storage.local)
# apiBase=https://your-api-domain/api
# websiteBase=https://your-website-domain
